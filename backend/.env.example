# Local API server
PORT=4010
NODE_ENV=development

# Aiven PostgreSQL connection placeholders
DB_HOST=your-service-host.aivencloud.com
DB_PORT=your-aiven-port
DB_NAME=defaultdb
DB_USER=your-database-user
DB_PASSWORD=replace-with-your-database-password

# Aiven CA certificate for verifying the server
DB_SSL_CA_PATH=./certs/ca.pem

# Curator Key Placeholder
CURATOR_API_KEY=replace-with-a-generated-development-key

# Hosting alternative: paste the full Aiven CA PEM into this private variable.
# DB_SSL_CA takes precedence over DB_SSL_CA_PATH; never disable TLS verification.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Optional private review dashboard. Disabled until both values are configured.
# Generate the hash with: node scripts/create-admin-password.js
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
